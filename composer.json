{
    "name": "redcodede/qr-gen",
    "description": "QR-Code-Generator für Statamic. Erzeugt aus einer URL QR-Codes als SVG und als druckfertiges PNG, mit oder ohne Bildmarke, ohne Bildextension.",
    "keywords": [
        "statamic",
        "statamic-addon",
        "qr",
        "qr-code",
        "svg",
        "verpackdg",
        "ppwr"
    ],
    "type": "statamic-addon",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/redcodede/qr-gen",
    "authors": [
        {
            "name": "Leo Woschke",
            "email": "lwoschke@redcode.org"
        }
    ],
    "support": {
        "email": "service@redcode.org",
        "issues": "https://github.com/redcodede/qr-gen/issues",
        "source": "https://github.com/redcodede/qr-gen"
    },
    "require": {
        "php": "^8.0",
        "bacon/bacon-qr-code": "^2.0 || ^3.0",
        "statamic/cms": "^3.4"
    },
    "require-dev": {
        "laravel/framework": "^8.83",
        "orchestra/testbench": "^6.18",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Redcodede\\QrGen\\": "src",
            "Redcodede\\QrGen\\Statamic\\": "src/Statamic"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Redcodede\\QrGen\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "QR-Gen",
            "slug": "qr-gen",
            "description": "Erzeugt QR-Codes als SVG und als druckfertiges PNG, mit oder ohne Bildmarke"
        },
        "laravel": {
            "providers": [
                "Redcodede\\QrGen\\Statamic\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:deprecations": "php -d error_reporting=32767 -d display_errors=1 vendor/bin/phpunit"
    }
}
